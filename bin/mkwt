#!/usr/bin/env bash
# mkwt — create a git worktree with configurable symlinks
set -euo pipefail

MKWT_VERSION="0.2.0"
MKWT_SOURCE_REVISION="source"

source_revision() {
  if [[ "$MKWT_SOURCE_REVISION" != source ]]; then
    printf '%s' "$MKWT_SOURCE_REVISION"
    return
  fi
  local root revision
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  if [[ -e "$root/.git" ]] && revision="$(automation_git "$root" rev-parse HEAD 2>/dev/null)"; then
    if [[ -n "$(automation_git "$root" status --porcelain 2>/dev/null)" ]]; then
      revision="$revision-dirty"
    fi
    printf '%s' "$revision"
  else
    printf 'unknown'
  fi
}

json_string() {
  local value="$1" char code i
  printf '"'
  for ((i=0; i<${#value}; i++)); do
    char="${value:i:1}"
    case "$char" in
      '"') printf '\\"' ;;
      '\') printf '\\\\' ;;
      *)
        printf -v code '%d' "'$char"
        if ((code < 32)); then printf '\\u%04x' "$code"; else printf '%s' "$char"; fi
        ;;
    esac
  done
  printf '"'
}

json_optional_string() {
  if [[ -n "$1" ]]; then json_string "$1"; else printf 'null'; fi
}

automation_git() (
  local context="$1" key
  shift
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
  unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS
  unset GIT_PREFIX GIT_NAMESPACE GIT_SHALLOW_FILE
  export GIT_TERMINAL_PROMPT=0 GIT_NO_LAZY_FETCH=1 GIT_LFS_SKIP_SMUDGE=1
  local options=(--no-pager --no-lazy-fetch --no-replace-objects -c core.hooksPath=/dev/null
    -c core.fsmonitor=false -c maintenance.auto=false -c gc.auto=0 -C "$context")
  while IFS= read -r -d '' key; do
    case "$key" in
      *.required) options+=(-c "$key=false") ;;
      *) options+=(-c "$key=") ;;
    esac
  done < <(command git "${options[@]}" config -z --name-only --get-regexp '^filter\..*\.(clean|smudge|process|required)$' 2>/dev/null || true)
  command git "${options[@]}" "$@" </dev/null
)

automation_absolute_path() {
  local input="$1" part physical i
  local parts=()
  [[ "$input" == /* ]] || input="$PWD/$input"
  IFS=/ read -r -d '' -a parts < <(printf '%s\0' "$input")
  AUTOMATION_ABSOLUTE_PATH="/"
  for ((i=0; i<${#parts[@]}; i++)); do
    part="${parts[i]}"
    case "$part" in
      ''|.) continue ;;
      ..) AUTOMATION_ABSOLUTE_PATH="${AUTOMATION_ABSOLUTE_PATH%/*}"; [[ -n "$AUTOMATION_ABSOLUTE_PATH" ]] || AUTOMATION_ABSOLUTE_PATH=/ ;;
      *)
        AUTOMATION_ABSOLUTE_PATH="${AUTOMATION_ABSOLUTE_PATH%/}/$part"
        if [[ -d "$AUTOMATION_ABSOLUTE_PATH" ]]; then
          physical="$(cd -P -- "$AUTOMATION_ABSOLUTE_PATH" && pwd -P && printf '\001')" || return 1
          AUTOMATION_ABSOLUTE_PATH="${physical%$'\n\001'}"
        elif [[ -e "$AUTOMATION_ABSOLUTE_PATH" || -L "$AUTOMATION_ABSOLUTE_PATH" ]]; then
          ((i == ${#parts[@]} - 1)) || return 1
        fi
        ;;
    esac
  done
}

automation_terminal_symlink() {
  local input="$1"
  while [[ "$input" != / ]]; do
    case "$input" in
      */) input="${input%/}" ;;
      */.) input="${input%/.}" ;;
      *) break ;;
    esac
  done
  [[ -L "$input" ]]
}

automation_snapshot() {
  A_PATH_EXISTS=false
  [[ -n "$A_PATH" && ( -e "$A_PATH" || -L "$A_PATH" ) ]] && A_PATH_EXISTS=true
  A_REGISTERED=false
  A_MAIN=false
  A_LOCKED=false
  [[ "$A_REPO_VALID" == true && -n "$A_PATH" ]] || return 0
  local field record_path="" index=-1 matching=false
  automation_git "$A_CONTEXT" worktree list --porcelain -z >/dev/null || return 1
  while IFS= read -r -d '' field; do
    case "$field" in
      'worktree '*)
        record_path="${field#worktree }"
        index=$((index + 1))
        matching=false
        automation_absolute_path "$record_path" || continue
        if [[ "$AUTOMATION_ABSOLUTE_PATH" == "$A_PATH" ]]; then
          matching=true
          A_REGISTERED=true
          A_HEAD=""
          A_BRANCH=""
          A_DETACHED=null
          ((index != 0)) || A_MAIN=true
        fi
        ;;
      'HEAD '*) [[ "$matching" == false ]] || A_HEAD="${field#HEAD }" ;;
      'branch '*)
        if [[ "$matching" == true ]]; then A_BRANCH="${field#branch refs/heads/}"; A_DETACHED=false; fi
        ;;
      detached) [[ "$matching" == false ]] || A_DETACHED=true ;;
      locked|locked\ *) [[ "$matching" == false ]] || A_LOCKED=true ;;
    esac
  done < <(automation_git "$A_CONTEXT" worktree list --porcelain -z)
}

automation_emit() {
  local status="$1" code="${2:-}" message="${3:-}" surviving=""
  automation_snapshot || { code=INSPECTION_FAILED; message="cannot inspect worktree registration"; status=error; }
  A_CREATED=false
  if [[ "$A_MUTATED" == true && ( "$A_PATH_EXISTS" == true || "$A_REGISTERED" == true ) ]]; then
    A_CREATED=true
    [[ "$A_PATH_EXISTS" == false ]] || surviving="$A_PATH"
    [[ -z "$code" ]] || status=partial_failure
  fi
  A_EMITTED=true
  if [[ "$A_JSON" == true ]]; then
    printf '{"schema_version":1,"operation":'; json_optional_string "$A_OPERATION"
    printf ',"status":'; json_string "$status"
    printf ',"workspace_path":'; json_optional_string "$A_PATH"
    printf ',"head_sha":'; json_optional_string "$A_HEAD"
    printf ',"branch":'; json_optional_string "$A_BRANCH"
    printf ',"detached":%s,"path_exists":%s,"worktree_registered":%s,"created_this_invocation":%s' "$A_DETACHED" "$A_PATH_EXISTS" "$A_REGISTERED" "$A_CREATED"
    printf ',"surviving_path":'; json_optional_string "$surviving"
    printf ',"version":'; json_string "$MKWT_VERSION"
    printf ',"source_revision":'; json_string "$A_REVISION"
    printf ',"error":'
    if [[ -n "$code" ]]; then
      printf '{"code":'; json_string "$code"; printf ',"message":'; json_string "$message"; printf '}'
    else
      printf 'null'
    fi
    printf '}\n'
  elif [[ -z "$code" ]]; then
    if [[ "$A_OPERATION" == version ]]; then
      printf 'mkwt %s (%s)\n' "$MKWT_VERSION" "$A_REVISION"
    else
      printf '%s\n' "$A_PATH"
      printf 'mkwt: %s\n' "$status" >&2
    fi
  fi
  [[ -z "$code" ]] || printf 'mkwt: error: %s: %s\n' "$code" "$message" >&2
  [[ -z "$code" ]]
}

automation_fail() {
  automation_emit error "$1" "$2" || true
  exit 1
}

automation_config() {
  [[ -f "$A_CONFIG" && -r "$A_CONFIG" ]] || automation_fail CONFIG_NOT_FOUND "config is missing or unreadable: $A_CONFIG"
  local line key value number=0
  local assignment='^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$'
  local double='^"([^"\\$`]*)"[[:space:]]*(#.*)?$'
  local single="^'([^']*)'[[:space:]]*(#.*)?$"
  local bare='^([^[:space:]#"$`\\;()<>|&]+)[[:space:]]*(#.*)?$'
  while IFS= read -r line || [[ -n "$line" ]]; do
    number=$((number + 1))
    line="${line%$'\r'}"
    [[ ! "$line" =~ ^[[:space:]]*(#.*)?$ ]] || continue
    [[ "$line" =~ $assignment ]] || automation_fail INVALID_CONFIG "expected a literal assignment at config line $number"
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    if [[ "$value" =~ $double || "$value" =~ $single ]]; then
      value="${BASH_REMATCH[1]}"
    elif [[ "$value" != *\'* && "$value" =~ $bare ]]; then
      value="${BASH_REMATCH[1]}"
    elif [[ "$value" =~ ^[[:space:]]*(#.*)?$ ]]; then
      value=""
    else
      automation_fail INVALID_CONFIG "config line $number must contain a literal value"
    fi
    case "$key" in
      SYMLINKS|WORKTREE_ENV|POST_CREATE_HOOK)
        [[ -z "$value" ]] || automation_fail INVALID_CONFIG "$key must be empty for unattended creation"
        ;;
      OPEN_IN_VSCODE)
        case "$value" in ''|ask|always|never) ;; *) automation_fail INVALID_CONFIG "invalid OPEN_IN_VSCODE value" ;; esac
        ;;
      BASE_BRANCH|WORKTREE_DIR|WORKTREE_ENV_FILE) ;;
      *) automation_fail INVALID_CONFIG "unknown config setting: $key" ;;
    esac
  done < "$A_CONFIG"
}

automation_main() {
  A_JSON=false A_OPERATION="" A_PATH="" A_REPO="" A_CONTEXT="" A_CONFIG="" A_COMMIT=""
  A_HEAD="" A_BRANCH="" A_DETACHED=null A_REGISTERED=false A_PATH_EXISTS=false
  A_REPO_VALID=false A_MUTATED=false A_CREATED=false A_EMITTED=false
  A_REVISION="$(source_revision)"
  local arg flag value detach=false force=false unattended=false path_input=""
  for arg in "$@"; do [[ "$arg" != --json ]] || A_JSON=true; done
  trap 'if [[ "$A_EMITTED" == false ]]; then automation_fail INTERNAL_ERROR "unexpected command failure"; fi' EXIT
  trap 'automation_fail INTERRUPTED "operation interrupted"' INT TERM
  A_OPERATION="${1:-}"
  [[ $# == 0 ]] || shift
  if [[ "$A_OPERATION" == --version ]]; then
    A_OPERATION=version
    [[ $# == 0 || ( $# == 1 && "$1" == --json ) ]] || automation_fail INVALID_ARGUMENTS "usage: mkwt --version [--json]"
    automation_emit ok
    exit 0
  fi
  case "$A_OPERATION" in create|remove) ;; *) automation_fail INVALID_ARGUMENTS "expected create or remove" ;; esac
  while [[ $# -gt 0 ]]; do
    flag="$1"; shift
    case "$flag" in
      --json) ;;
      --non-interactive) unattended=true ;;
      --detach) detach=true ;;
      --force) force=true ;;
      --repo|--path|--commit|--config|--repo=*|--path=*|--commit=*|--config=*)
        if [[ "$flag" == *=* ]]; then
          value="${flag#*=}"; flag="${flag%%=*}"
        else
          [[ $# -gt 0 && "$1" != --* ]] || automation_fail INVALID_ARGUMENTS "$flag requires a value"
          value="$1"; shift
        fi
        [[ -n "$value" ]] || automation_fail INVALID_ARGUMENTS "$flag requires a nonempty value"
        case "$flag" in
          --repo) [[ -z "$A_REPO" ]] || automation_fail INVALID_ARGUMENTS "duplicate --repo"; A_REPO="$value" ;;
          --path)
            [[ -z "$A_PATH" ]] || automation_fail INVALID_ARGUMENTS "duplicate --path"
            path_input="$value"
            automation_absolute_path "$value" || automation_fail INVALID_PATH "cannot resolve workspace path"
            A_PATH="$AUTOMATION_ABSOLUTE_PATH"
            ;;
          --commit) [[ -z "$A_COMMIT" ]] || automation_fail INVALID_ARGUMENTS "duplicate --commit"; A_COMMIT="$value" ;;
          --config) [[ -z "$A_CONFIG" ]] || automation_fail INVALID_ARGUMENTS "duplicate --config"; A_CONFIG="$value" ;;
        esac
        ;;
      *) automation_fail INVALID_ARGUMENTS "unknown argument: $flag" ;;
    esac
  done
  [[ "$unattended" == true && -n "$A_REPO" && -n "$A_PATH" ]] || automation_fail INVALID_ARGUMENTS "--repo, --path and --non-interactive are required"
  if [[ "$A_OPERATION" == create ]]; then
    [[ "$detach" == true && -n "$A_COMMIT" && -n "$A_CONFIG" && "$force" == false ]] || automation_fail INVALID_ARGUMENTS "create requires --commit, --detach and --config, and does not accept --force"
    [[ "$A_COMMIT" =~ ^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]] || automation_fail INVALID_ARGUMENTS "--commit must be a full commit object ID"
  else
    [[ "$detach" == false && -z "$A_COMMIT" && -z "$A_CONFIG" ]] || automation_fail INVALID_ARGUMENTS "remove does not accept --commit, --detach or --config"
  fi
  ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))) || automation_fail UNSUPPORTED_BASH "automation requires Bash 4.4 or newer"
  command git --no-lazy-fetch --version >/dev/null 2>&1 || automation_fail UNSUPPORTED_GIT "automation requires Git with --no-lazy-fetch support (Git 2.48 or newer)"
  automation_absolute_path "$A_REPO" || automation_fail INVALID_REPOSITORY "cannot resolve repository path"
  A_REPO="$AUTOMATION_ABSOLUTE_PATH"
  local common
  common="$(automation_git "$A_REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null && printf '\001')" || automation_fail INVALID_REPOSITORY "not a Git repository: $A_REPO"
  common="${common%$'\n\001'}"
  A_CONTEXT="$common"
  A_REPO_VALID=true
  automation_snapshot || automation_fail INSPECTION_FAILED "cannot list repository worktrees"
  if [[ "$A_OPERATION" == create ]]; then
    automation_config
    [[ "$A_PATH_EXISTS" == false && "$A_REGISTERED" == false ]] && ! automation_terminal_symlink "$path_input" || automation_fail PATH_COLLISION "destination already exists or is registered: $A_PATH"
    local object_type
    object_type="$(automation_git "$A_CONTEXT" cat-file -t "$A_COMMIT" 2>/dev/null)" || automation_fail COMMIT_UNAVAILABLE "requested object is unavailable locally: $A_COMMIT"
    [[ "$object_type" == commit ]] || automation_fail NOT_A_COMMIT "requested object is not a commit: $A_COMMIT"
    mkdir -p -- "$(dirname -- "$A_PATH")" >&2 || automation_fail CREATE_FAILED "cannot create destination parent"
    if ! mkdir -- "$A_PATH" >&2; then
      if [[ -e "$A_PATH" || -L "$A_PATH" ]]; then
        automation_fail PATH_COLLISION "destination appeared during creation: $A_PATH"
      fi
      automation_fail CREATE_FAILED "cannot reserve destination directory"
    fi
    A_MUTATED=true
    automation_git "$A_CONTEXT" worktree add --detach --no-checkout -- "$A_PATH" "$A_COMMIT" >&2 || automation_fail CREATE_FAILED "Git worktree creation failed"
    automation_git "$A_PATH" reset --hard "$A_COMMIT" >&2 || automation_fail CHECKOUT_FAILED "checkout failed; inspect the surviving worktree"
    automation_snapshot || automation_fail INSPECTION_FAILED "cannot inspect created worktree"
    [[ "${A_HEAD,,}" == "${A_COMMIT,,}" && "$A_DETACHED" == true ]] || automation_fail HEAD_MISMATCH "created worktree does not have the requested detached HEAD"
    automation_emit created
  else
    ! automation_terminal_symlink "$path_input" || automation_fail INVALID_PATH "workspace path must not be a symlink"
    if [[ "$A_REGISTERED" == false ]]; then
      [[ "$A_PATH_EXISTS" == false ]] || automation_fail NOT_REGISTERED "existing destination is not a registered worktree of this repository"
      automation_emit already_absent
      exit 0
    fi
    [[ "$A_MAIN" == false ]] || automation_fail MAIN_WORKTREE "the main checkout cannot be removed"
    [[ "$A_PATH_EXISTS" == true ]] || automation_fail STALE_REGISTRATION "worktree is registered but missing; inspect or repair it explicitly"
    [[ "$A_LOCKED" == false ]] || automation_fail WORKTREE_LOCKED "locked worktrees must be unlocked explicitly"
    local target_common top dirty gitdir backlink
    target_common="$(automation_git "$A_PATH" rev-parse --path-format=absolute --git-common-dir 2>/dev/null && printf '\001')" || automation_fail NOT_REGISTERED "cannot verify target repository"
    target_common="${target_common%$'\n\001'}"
    [[ "$common" == "$target_common" && -f "$A_PATH/.git" ]] || automation_fail NOT_REGISTERED "target does not identify a linked worktree of this repository"
    gitdir="$(automation_git "$A_PATH" rev-parse --absolute-git-dir && printf '\001')" || automation_fail NOT_REGISTERED "cannot verify target registration"
    gitdir="${gitdir%$'\n\001'}"
    [[ -f "$gitdir/gitdir" ]] || automation_fail NOT_REGISTERED "missing worktree registration backlink"
    backlink="$(cat -- "$gitdir/gitdir" && printf '\001')" || automation_fail NOT_REGISTERED "cannot read worktree registration backlink"
    automation_absolute_path "${backlink%$'\n\001'}" || automation_fail NOT_REGISTERED "cannot resolve worktree registration backlink"
    [[ "$AUTOMATION_ABSOLUTE_PATH" == "$A_PATH/.git" ]] || automation_fail NOT_REGISTERED "target Git metadata belongs to a different worktree"
    top="$(automation_git "$A_PATH" rev-parse --show-toplevel && printf '\001')" || automation_fail INSPECTION_FAILED "cannot inspect target worktree"
    automation_absolute_path "${top%$'\n\001'}" || automation_fail INVALID_PATH "cannot resolve target checkout"
    [[ "$AUTOMATION_ABSOLUTE_PATH" == "$A_PATH" ]] || automation_fail NOT_REGISTERED "target path is not the registered checkout root"
    if [[ "$force" == false ]]; then
      dirty="$(automation_git "$A_PATH" status --porcelain --untracked-files=all --ignored=matching)" || automation_fail INSPECTION_FAILED "cannot inspect worktree changes"
      [[ -z "$dirty" ]] || automation_fail DIRTY_WORKTREE "worktree contains changes, untracked or ignored files; use --force to discard them"
    fi
    local options=()
    [[ "$force" == false ]] || options+=(--force)
    automation_git "$A_CONTEXT" worktree remove "${options[@]}" -- "$A_PATH" >&2 || automation_fail REMOVE_FAILED "Git worktree removal failed"
    automation_emit removed
  fi
  exit 0
}

automation=false
for argument in "$@"; do
  case "$argument" in
    --version|--repo|--repo=*|--path|--path=*|--commit|--commit=*|--detach|--config|--config=*|--non-interactive|--json|--force) automation=true ;;
  esac
done
if [[ "$automation" == true ]]; then automation_main "$@"; fi

log()  { printf '%s\n' "$*" >&2; }
warn() { printf 'mkwt: warning: %s\n' "$*" >&2; }
err()  { printf 'mkwt: error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
Usage: mkwt <branch> [--base <branch>] [--vscode | --no-vscode]
       mkwt create --repo <repo> --path <path> --commit <sha> --detach
                   --config <file> --non-interactive [--json]
       mkwt remove --repo <repo> --path <path> --non-interactive [--force] [--json]
       mkwt --version [--json]
       mkwt -h | --help

Creates a git worktree at <repo-root>/<WORKTREE_DIR>/<branch>, with configured
symlinks from the main checkout. Reads config from .worktrees/mkwt.conf.
Runs an interactive setup wizard on first use.

Options:
  --base <branch>   Override BASE_BRANCH for this invocation
  --vscode          Open the new worktree in VS Code (skip prompt)
  --no-vscode       Skip opening VS Code (skip prompt)
  -h, --help        Show this help

Output:
  stdout: absolute path to the new worktree
  stderr: progress messages and a final cd hint

Compose with cd:
  cd "$(mkwt fix/eng-321)"
EOF
}

BRANCH=""
BASE_OVERRIDE=""
OPEN_IN_VSCODE_OVERRIDE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --base)
      shift
      [[ $# -gt 0 ]] || err "--base requires a value"
      BASE_OVERRIDE="$1"
      shift
      ;;
    --base=*) BASE_OVERRIDE="${1#*=}"; shift ;;
    --vscode) OPEN_IN_VSCODE_OVERRIDE="always"; shift ;;
    --no-vscode) OPEN_IN_VSCODE_OVERRIDE="never"; shift ;;
    --) shift; break ;;
    -*) err "unknown flag: $1" ;;
    *)
      [[ -z "$BRANCH" ]] || err "unexpected argument: $1"
      BRANCH="$1"
      shift
      ;;
  esac
done

if [[ -z "$BRANCH" ]]; then
  usage
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || err "not inside a git repository"
cd "$REPO_ROOT"

CONFIG_DIR=".worktrees"
CONFIG_PATH="$CONFIG_DIR/mkwt.conf"

SYMLINKS=""
WORKTREE_DIR=".worktrees"
BASE_BRANCH=""
POST_CREATE_HOOK=""
WORKTREE_ENV_FILE=".env.worktree"
WORKTREE_ENV=""
OPEN_IN_VSCODE="ask"

run_wizard() {
  log ""
  log "mkwt: no config found at $CONFIG_PATH — running setup wizard"
  log ""

  local detected_base
  detected_base="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
  if [[ -z "$detected_base" ]]; then
    detected_base="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  fi

  local detected_symlinks=()
  [[ -e .env ]]                          && detected_symlinks+=(".env")
  [[ -e .envrc ]]                        && detected_symlinks+=(".envrc")
  [[ -e Gemfile ]]                       && detected_symlinks+=("vendor/bundle")
  [[ -e package.json ]]                  && detected_symlinks+=("node_modules")
  [[ -e .claude/settings.local.json ]]   && detected_symlinks+=(".claude/settings.local.json")

  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_PATH" <<EOF
# mkwt config — bash-sourceable
# Edit and re-run mkwt at any time.

# Paths to symlink from main checkout into each new worktree (space-separated).
# Missing sources are warned and skipped.
SYMLINKS="${detected_symlinks[*]:-}"

# Where worktrees live, relative to repo root.
WORKTREE_DIR=".worktrees"

# Default base branch when creating a new branch.
# Override per invocation with: mkwt <branch> --base <other-branch>
BASE_BRANCH="$detected_base"

# Optional command run via 'bash -c' inside the new worktree after creation.
# Example: POST_CREATE_HOOK="bundle install"
POST_CREATE_HOOK=""

# Per-worktree env vars — useful for parallel test DBs across worktrees.
# {n} expands to an integer unique per active worktree (1, 2, 3, ...).
# mkwt picks the smallest unused index and writes <worktree>/\$WORKTREE_ENV_FILE
# before POST_CREATE_HOOK runs. Empty = disabled.
# Example: WORKTREE_ENV='TEST_ENV_NUMBER={n}'
WORKTREE_ENV_FILE=".env.worktree"
WORKTREE_ENV=""

# After creating the worktree, whether to open it in VS Code.
# Values: ask (prompt; default), always (open without asking), never (skip silently).
# Override per invocation with --vscode / --no-vscode.
OPEN_IN_VSCODE="ask"
EOF

  log "Generated $CONFIG_PATH:"
  log ""
  sed 's/^/  /' "$CONFIG_PATH" >&2
  log ""

  printf 'Use these defaults? [Y/n/edit] ' >&2
  local answer=""
  read -r answer || true
  case "$answer" in
    [Ee]*) "${EDITOR:-vi}" "$CONFIG_PATH" ;;
    [Nn]*) err "wizard aborted; edit $CONFIG_PATH manually and re-run" ;;
    *) ;;
  esac

  if [[ -f .gitignore ]]; then
    if ! grep -qE '^\.worktrees/?$' .gitignore; then
      printf 'Add .worktrees/ to .gitignore? [Y/n] ' >&2
      read -r answer || true
      case "$answer" in
        [Nn]*) ;;
        *)
          [[ -s .gitignore && "$(tail -c1 .gitignore)" != $'\n' ]] && printf '\n' >> .gitignore
          printf '.worktrees/\n' >> .gitignore
          log "Added .worktrees/ to .gitignore"
          ;;
      esac
    fi
  else
    printf 'Create .gitignore with .worktrees/? [Y/n] ' >&2
    read -r answer || true
    case "$answer" in
      [Nn]*) ;;
      *)
        printf '.worktrees/\n' > .gitignore
        log "Created .gitignore"
        ;;
    esac
  fi

  log ""
  log "mkwt: config saved. Continuing with worktree creation..."
  log ""
}

if [[ ! -f "$CONFIG_PATH" ]]; then
  run_wizard
fi

# shellcheck disable=SC1090
source "$CONFIG_PATH"

if [[ -n "$BASE_OVERRIDE" ]]; then
  BASE_BRANCH="$BASE_OVERRIDE"
fi

if [[ -n "$OPEN_IN_VSCODE_OVERRIDE" ]]; then
  OPEN_IN_VSCODE="$OPEN_IN_VSCODE_OVERRIDE"
fi

[[ -n "$BASE_BRANCH" ]] || err "BASE_BRANCH is empty (set it in $CONFIG_PATH or pass --base)"

if [[ -n "${WORKTREE_ENV:-}" ]]; then
  for sym_path in ${SYMLINKS:-}; do
    if [[ "$sym_path" == "$WORKTREE_ENV_FILE" ]]; then
      err "WORKTREE_ENV_FILE ('$WORKTREE_ENV_FILE') conflicts with SYMLINKS entry. Remove '$WORKTREE_ENV_FILE' from SYMLINKS — mkwt will copy it from main and append per-worktree vars."
    fi
  done
fi

if ! git rev-parse --verify --quiet "refs/heads/$BASE_BRANCH" >/dev/null \
   && ! git rev-parse --verify --quiet "refs/remotes/origin/$BASE_BRANCH" >/dev/null; then
  err "base branch '$BASE_BRANCH' not found locally or on origin"
fi

WT_PATH="$REPO_ROOT/$WORKTREE_DIR/$BRANCH"

if [[ -e "$WT_PATH" ]]; then
  err "$WT_PATH already exists. Remove it first."
fi

if git worktree list --porcelain | awk '/^worktree /{print $2}' | grep -Fxq "$WT_PATH"; then
  err "worktree at $WT_PATH is already registered. Use 'git worktree remove' first."
fi

log "Fetching origin $BRANCH..."
if ! git fetch origin "$BRANCH" --quiet 2>/dev/null; then
  warn "fetch failed (offline, no remote ref, or no 'origin'); continuing"
fi

mkdir -p "$(dirname "$WT_PATH")"

if git rev-parse --verify --quiet "refs/heads/$BRANCH" >/dev/null; then
  log "Branch '$BRANCH' exists locally — checking out at $WT_PATH"
  git worktree add "$WT_PATH" "$BRANCH" >&2
elif git rev-parse --verify --quiet "refs/remotes/origin/$BRANCH" >/dev/null; then
  log "Branch 'origin/$BRANCH' exists on remote — creating local tracking branch at $WT_PATH"
  git worktree add -b "$BRANCH" "$WT_PATH" "origin/$BRANCH" >&2
else
  log "Creating new branch '$BRANCH' from '$BASE_BRANCH' at $WT_PATH"
  git worktree add -b "$BRANCH" "$WT_PATH" "$BASE_BRANCH" >&2
fi

# Per-worktree env file: pick smallest unused integer >= 1 by reading
# '# mkwt-index: N' markers from existing worktrees, then write the file.
compute_worktree_index() {
  local file="$1"
  local in_use=()
  local line wt idx
  while IFS= read -r line; do
    [[ "$line" == "worktree "* ]] || continue
    wt="${line#worktree }"
    [[ -f "$wt/$file" ]] || continue
    idx="$(awk '/^# mkwt-index:/ { print $3; exit }' "$wt/$file" 2>/dev/null || true)"
    [[ "$idx" =~ ^[0-9]+$ ]] && in_use+=("$idx")
  done < <(git worktree list --porcelain)

  local n=1
  if (( ${#in_use[@]} > 0 )); then
    while printf '%s\n' "${in_use[@]}" | grep -qx "$n"; do
      ((n++))
    done
  fi
  printf '%d' "$n"
}

write_worktree_env_file() {
  local index="$1"
  local target="$WT_PATH/$WORKTREE_ENV_FILE"
  local main_src="$REPO_ROOT/$WORKTREE_ENV_FILE"

  if [[ -e "$target" ]]; then
    warn "$WORKTREE_ENV_FILE already exists in worktree, leaving it alone"
    return
  fi

  mkdir -p "$(dirname "$target")"

  if [[ -f "$main_src" ]]; then
    cp "$main_src" "$target"
    log "Copied $WORKTREE_ENV_FILE from main checkout"
  fi

  local content="${WORKTREE_ENV//\{n\}/$index}"
  {
    if [[ -s "$target" ]]; then
      [[ "$(tail -c1 "$target")" != $'\n' ]] && printf '\n'
      printf '\n'
    fi
    printf '# === mkwt-managed (do not edit) ===\n'
    printf '# mkwt-index: %s\n' "$index"
    printf '%s\n' "$content"
    printf '# === end mkwt-managed ===\n'
  } >> "$target"

  log "Wrote per-worktree env to $WORKTREE_ENV_FILE (mkwt-index: $index)"
}

if [[ -n "${WORKTREE_ENV:-}" ]]; then
  WT_INDEX="$(compute_worktree_index "$WORKTREE_ENV_FILE")"
  write_worktree_env_file "$WT_INDEX"
fi

# Compute relative symlink target. The number of '../' equals the number of
# path segments between repo root and the symlink's parent directory.
relative_target() {
  local symlink_rel_dir="$1"  # e.g., ".worktrees/fix/eng-321/vendor"
  local target_rel="$2"       # e.g., "vendor/bundle"
  local depth prefix=""
  if [[ "$symlink_rel_dir" == "." || -z "$symlink_rel_dir" ]]; then
    depth=0
  else
    depth=$(awk -F/ '{print NF}' <<< "$symlink_rel_dir")
  fi
  local i
  for ((i=0; i<depth; i++)); do prefix="../$prefix"; done
  printf '%s%s' "$prefix" "$target_rel"
}

if [[ -n "${SYMLINKS:-}" ]]; then
  for path in $SYMLINKS; do
    src="$REPO_ROOT/$path"
    dst="$WT_PATH/$path"

    if [[ ! -e "$src" ]]; then
      warn "$path does not exist in main checkout, skipping"
      continue
    fi

    if [[ -e "$dst" || -L "$dst" ]]; then
      warn "$path already exists in worktree, skipping symlink"
      continue
    fi

    mkdir -p "$(dirname "$dst")"
    symlink_rel_dir="$(dirname "$WORKTREE_DIR/$BRANCH/$path")"
    target="$(relative_target "$symlink_rel_dir" "$path")"
    ln -s "$target" "$dst"
    log "Linked $path → $target"
  done
fi

hook_failed=0
if [[ -n "${POST_CREATE_HOOK:-}" ]]; then
  log ""
  log "Running post-create hook: $POST_CREATE_HOOK"
  if ! ( cd "$WT_PATH" && bash -c "$POST_CREATE_HOOK" ) >&2; then
    warn "post-create hook exited non-zero; worktree left in place"
    hook_failed=1
  fi
fi

log ""
log "Worktree ready at $WT_PATH"
log "→ cd \"\$(mkwt $BRANCH)\""

open_vscode=0
case "${OPEN_IN_VSCODE:-ask}" in
  always) open_vscode=1 ;;
  never) ;;
  ask|"")
    if command -v code >/dev/null 2>&1 && [[ -t 0 ]]; then
      printf 'Open in VS Code? [y/N] ' >&2
      read -r open_answer || true
      case "$open_answer" in
        [Yy]*) open_vscode=1 ;;
      esac
    fi
    ;;
  *) warn "unknown OPEN_IN_VSCODE value '$OPEN_IN_VSCODE' (expected ask|always|never); skipping VS Code launch" ;;
esac

if (( open_vscode )); then
  if command -v code >/dev/null 2>&1; then
    code "$WT_PATH" >/dev/null 2>&1 || warn "failed to launch 'code'"
  else
    warn "'code' command not found in PATH; skipping VS Code launch"
  fi
fi

printf '%s\n' "$WT_PATH"

exit $hook_failed
